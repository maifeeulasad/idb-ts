{
  "name": "idb-ts-example",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm exec esbuild index.ts --bundle --platform=browser --format=iife --conditions=require --outfile=index.js --servedir=. --serve=8000 --watch",
    "build": "pnpm exec esbuild index.ts --bundle --platform=browser --format=iife --conditions=require --outfile=index.js && mkdir -p build/typescript && cp index.html index.js build/typescript"
  },
  "author": "Maifee Ul Asad <maifeeulasad@gmail.com>",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "idb-ts": "^3.16.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.2"
  },
  "type": "module"
}
